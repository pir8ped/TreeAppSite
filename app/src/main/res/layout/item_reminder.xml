<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/reminder_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:id="@+id/reminder_content_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/reminder_urgent_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠ URGENT"
                    android:textColor="#E53935"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/reminder_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="2024-03-21"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="#757575" />
            </RelativeLayout>

            <TextView
                android:id="@+id/reminder_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reminder description goes here"
                android:textSize="16sp"
                android:textColor="#212121"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/reminder_tree_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Tree: Apple (123)"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="#9E9E9E"
                android:layout_marginTop="4dp"
                android:textStyle="italic" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
