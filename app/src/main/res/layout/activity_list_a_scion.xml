<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scion to list"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:paddingBottom="16dp"/>

        <TextView
            android:text="English Name:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/text_english_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EFEFEF"
            android:padding="8dp"/>

        <TextView
            android:text="Latin Name:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/text_latin_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EFEFEF"
            android:padding="8dp"/>

        <TextView
            android:text="Characteristics:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/text_Characteristics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EFEFEF"
            android:padding="8dp"/>

        <TextView
            android:text="Source (optional):"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edit_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter source"
            android:minHeight="48dp" />

        <TextView
            android:text="Variety (optional):"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edit_variety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter variety"
            android:minHeight="48dp" />

        <TextView
            android:text="Quantity:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edit_quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter quantity"
            android:inputType="number"
            android:minHeight="48dp"
            android:text="1" />

        <Button
            android:id="@+id/button_add_scion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Scion"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>
